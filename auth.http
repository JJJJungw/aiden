@baseUrl = http://127.0.0.1:8000
@googleIdToken = paste_google_id_token_here

###
# Health check
GET {{baseUrl}}/health

###
# Google login
# 1. /dev/google-test 에서 로그인하거나
# 2. 프론트에서 받은 Google ID Token 을 @googleIdToken 에 붙여넣으세요.
# 응답 헤더의 Set-Cookie 로 HttpOnly access_token 쿠키가 저장됩니다.
POST {{baseUrl}}/auth/google
Content-Type: application/json

{
  "id_token": "{{googleIdToken}}"
}

###
# Current user
# HTTP Client 의 cookie jar 에 저장된 access_token 쿠키를 사용합니다.
GET {{baseUrl}}/auth/me

###
# Logout
# 만료된 access token 쿠키를 다시 내려보냅니다.
POST {{baseUrl}}/auth/logout

###
# Current user after logout
# 정상이라면 401 이 반환되어야 합니다.
GET {{baseUrl}}/auth/me
